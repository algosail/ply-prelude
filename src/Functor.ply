@ Functor, map, flip

~ "Number" mul, add

.. Apply a quotation inside the container. The quotation is on top.
& Functor f
  .. The container of results. The quotation is on top.
  map ( (f a) (a -- b) -- (f b) )

? "map" < < 10 20 > > [ < 1 2 > [ 10 mul ] map ]

: flip ( Functor f => a (f ( a -- b )) -- (f b) )
  swap [ swap call ] cons map

? "flip" < < 11 > > [ 10 < [ 1 add ] > flip ]

. ..................................................................................................

# Functor Array
  map = map_array

: foreign map_array ( (Array a) (a -- b) -- (Array b) )
